# Ignore large matrices, FASTQ/BAM, results, and vendor binaries.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.snakemake/
.venv/
**/._*
.DS_Store
results/**
!results/.gitkeep
data/ref/**
!data/ref/README.md
data/panel/**
!data/panel/README.md
data/fastq/**
!data/fastq/README.md
data/cloud/**
!data/cloud/.gitkeep
*.npz
*.bam
*.fastq.gz
*.fq.gz
# keep demo HTML package; ignore other large VCFs if added under data/

# Keep a stub README so the empty results/ folder is explained on GitHub
!results/
!results/README.md
# Local Docker mounts
/input/**
!/input/.gitkeep
/output/**
!/output/.gitkeep
/settings/**
!/settings/.gitkeep
# Private customer image blob (never commit)
/grapeancestry-v1.0.0-amd64.tar
