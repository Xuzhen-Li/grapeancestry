# GrapeAncestry v1 — FASTQ / BAM → 167K panel VCF on VS-1
#   snakemake -s workflow/Snakefile --configfile config/default.yaml \
#     --config samples_file=... -j 4 results/{sample}.vcf.gz

import os
from pathlib import Path

ROOT = Path(workflow.basedir).parent

configfile: str(ROOT / "config" / "default.yaml")

SAMPLES_FILE = config.get("samples_file", str(ROOT / "config" / "default.yaml"))
import yaml
with open(SAMPLES_FILE) as _fh:
    _sdata = yaml.safe_load(_fh)
SAMPLES = _sdata["samples"]

THREADS = int(config.get("threads", 4))
MAPPING = config.get("mapping", "full")
FASTP_MIN_LEN = int(config.get("fastp_min_length", 15))
FASTP_QUAL = int(config.get("fastp_qualified_quality", 15))
FASTP_UNQUAL = int(config.get("fastp_unqualified_percent", 40))
FASTP_NBASE = int(config.get("fastp_n_base_limit", 5))
FASTP_POLY_G = str(config.get("fastp_poly_g", "auto"))
FASTP_CUT_TAIL = bool(config.get("fastp_cut_tail", False))
FASTP_CUT_MEAN = int(config.get("fastp_cut_mean_quality", 20))
FASTP_DETECT_PE = bool(config.get("fastp_detect_adapter_pe", True))
ADNA_MIN_LEN = int(config.get("adna_min_length", 25))
ADNA_ADAPTER_SEL = str(config.get("adna_adapter_selection", "auto"))
ADNA_ADAPTER1 = str(config.get("adna_adapter1", "") or "")
ADNA_QUAL_TRIM = str(config.get("adna_quality_trimming", "mott"))
ADNA_TRIM_MINQ = int(config.get("adna_trim_min_quality", 2))
ADNA_MOTT = float(config.get("adna_trim_mott_rate", 0.05))
ADNA_MIN_OV = int(config.get("adna_min_overlap", 1))
ADNA_MISMATCH = float(config.get("adna_mismatch_rate", 0.1667))
ADNA_POLYX = str(config.get("adna_pre_trim_polyx", "auto"))
ADNA_MIN_MEANQ = int(config.get("adna_min_mean_quality", 0))
BWA_MEM_SEED = int(config.get("bwa_mem_seed", 19))
BWA_MEM_T = int(config.get("bwa_mem_min_score", 30))
BWA_ALN_L = int(config.get("bwa_aln_l", 1024))
BWA_ALN_N = float(config.get("bwa_aln_n", 0.01))
BWA_ALN_O = int(config.get("bwa_aln_max_gap", 1))
MIN_MQ = int(config.get("min_mq", 0))
MIN_BQ = int(config.get("min_bq", 13))
MAX_DEPTH = int(config.get("max_depth", 250))
ADJUST_MQ = int(config.get("adjust_mq", 0))
MIN_DP = int(config.get("min_dp", 0))
REF_FA = str(ROOT / config["paths"]["ref_fa"])
PANEL_VCF = str(ROOT / config["paths"]["panel_vcf"])
SITES_BED = str(ROOT / "data" / "panel" / "panel167k.sites.bed")
REF_FAI = REF_FA + ".fai"
RESULTS = config["paths"].get("results", "results")

ALIGN_REF = REF_FA
if MAPPING == "subref":
    raise ValueError("v1 ships VS-1 full mapping only; do not set mapping=subref")


def _fastp_extra(*, pe: bool) -> str:
    parts = [
        f"--unqualified_percent_limit {FASTP_UNQUAL}",
        f"--n_base_limit {FASTP_NBASE}",
    ]
    if FASTP_POLY_G == "on":
        parts.append("--trim_poly_g")
    elif FASTP_POLY_G == "off":
        parts.append("--disable_trim_poly_g")
    if FASTP_CUT_TAIL:
        parts.append(f"--cut_tail --cut_mean_quality {FASTP_CUT_MEAN}")
    if pe and FASTP_DETECT_PE:
        parts.append("--detect_adapter_for_pe")
    return " ".join(parts)


def _ar3_extra() -> str:
    parts = [
        f"--adapter-selection {ADNA_ADAPTER_SEL}",
        f"--quality-trimming {ADNA_QUAL_TRIM}",
        f"--trim-min-quality {ADNA_TRIM_MINQ}",
        f"--trim-mott-rate {ADNA_MOTT}",
        f"--min-overlap {ADNA_MIN_OV}",
        f"--mismatch-rate {ADNA_MISMATCH}",
        f"--pre-trim-polyx {ADNA_POLYX}",
    ]
    if ADNA_ADAPTER1:
        if any(ch not in "ACGTNacgtn" for ch in ADNA_ADAPTER1):
            raise ValueError("adna_adapter1 must be ACGTN")
        parts.append(f"--adapter1 {ADNA_ADAPTER1}")
    if ADNA_MIN_MEANQ > 0:
        parts.append(f"--min-mean-quality {ADNA_MIN_MEANQ}")
    return " ".join(parts)


def _dp_filter() -> str:
    if MIN_DP <= 0:
        return ""
    return f"-e 'FORMAT/DP<{MIN_DP}'"


def _abs_or_root(path):
    p = Path(path)
    return str(p if p.is_absolute() else ROOT / p)


def sample_r1(wildcards):
    return _abs_or_root(SAMPLES[wildcards.sample]["r1"])


def sample_r2(wildcards):
    s = SAMPLES[wildcards.sample]
    if s["type"] != "pe":
        raise ValueError(f"{wildcards.sample} is not PE")
    return _abs_or_root(s["r2"])


def sample_bam(wildcards):
    s = SAMPLES[wildcards.sample]
    if s["type"] != "bam":
        raise ValueError(f"{wildcards.sample} is not BAM")
    return _abs_or_root(s["bam"])


def is_pe(sample):
    s = SAMPLES[sample]
    if s["type"] == "bam":
        return bool(s.get("paired", False))
    return s["type"] == "pe"


def is_adna(sample):
    return SAMPLES[sample]["type"] == "adna"


def is_se(sample):
    return SAMPLES[sample]["type"] == "se"


def is_bam(sample):
    return SAMPLES[sample]["type"] == "bam"


PE_SAMPLES = [s for s in SAMPLES if SAMPLES[s]["type"] == "pe"]
SE_SAMPLES = [s for s in SAMPLES if is_se(s)]
ADNA_SAMPLES = [s for s in SAMPLES if is_adna(s)]
BAM_SAMPLES = [s for s in SAMPLES if is_bam(s)]
FQ_SAMPLES = [s for s in SAMPLES if not is_bam(s)]
PE_WC = "|".join(PE_SAMPLES) if PE_SAMPLES else "none"
SE_WC = "|".join(SE_SAMPLES) if SE_SAMPLES else "none"
ADNA_WC = "|".join(ADNA_SAMPLES) if ADNA_SAMPLES else "none"
BAM_WC = "|".join(BAM_SAMPLES) if BAM_SAMPLES else "none"
FQ_WC = "|".join(FQ_SAMPLES) if FQ_SAMPLES else "none"
ANY_WC = "|".join(SAMPLES) if SAMPLES else "none"


rule all:
    input:
        expand(os.path.join(RESULTS, "{sample}.vcf.gz"), sample=SAMPLES),


rule trim_pe:
    input:
        r1=sample_r1,
        r2=sample_r2,
    output:
        r1=temp(os.path.join(RESULTS, "trim", "{sample}_1.fq.gz")),
        r2=temp(os.path.join(RESULTS, "trim", "{sample}_2.fq.gz")),
        html=os.path.join(RESULTS, "trim", "{sample}.fastp.html"),
        json=os.path.join(RESULTS, "trim", "{sample}.fastp.json"),
    threads: THREADS
    params:
        min_len=FASTP_MIN_LEN,
        qual=FASTP_QUAL,
        extra=_fastp_extra(pe=True),
    wildcard_constraints:
        sample=PE_WC,
    shell:
        """
        mkdir -p $(dirname {output.r1})
        fastp -w {threads} \
          -i {input.r1} -I {input.r2} \
          -o {output.r1} -O {output.r2} \
          -h {output.html} -j {output.json} \
          --length_required {params.min_len} \
          --qualified_quality_phred {params.qual} \
          {params.extra}
        """


rule trim_se:
    input:
        r1=sample_r1,
    output:
        r1=temp(os.path.join(RESULTS, "trim", "{sample}.fq.gz")),
        html=os.path.join(RESULTS, "trim", "{sample}.fastp.html"),
        json=os.path.join(RESULTS, "trim", "{sample}.fastp.json"),
    threads: THREADS
    params:
        min_len=FASTP_MIN_LEN,
        qual=FASTP_QUAL,
        extra=_fastp_extra(pe=False),
    wildcard_constraints:
        sample=SE_WC,
    shell:
        """
        mkdir -p $(dirname {output.r1})
        fastp -w {threads} \
          -i {input.r1} -o {output.r1} \
          -h {output.html} -j {output.json} \
          --length_required {params.min_len} \
          --qualified_quality_phred {params.qual} \
          {params.extra}
        """


rule trim_adna:
    """aDNA SE: AdapterRemoval3 trim (adapters + min length)."""
    input:
        r1=sample_r1,
    output:
        r1=temp(os.path.join(RESULTS, "trim", "{sample}.fq.gz")),
        log=os.path.join(RESULTS, "trim", "{sample}.adapterremoval.log"),
        html=os.path.join(RESULTS, "trim", "{sample}.adapterremoval.html"),
        json=os.path.join(RESULTS, "trim", "{sample}.adapterremoval.json"),
    threads: THREADS
    params:
        min_len=ADNA_MIN_LEN,
        extra=_ar3_extra(),
    wildcard_constraints:
        sample=ADNA_WC,
    shell:
        """
        mkdir -p $(dirname {output.r1})
        adapterremoval3 \
          --in-file1 {input.r1} \
          --out-file1 {output.r1} \
          --out-html {output.html} \
          --out-json {output.json} \
          --min-length {params.min_len} \
          --threads {threads} \
          {params.extra} \
          > {output.log} 2>&1
        """


rule ingest_bam:
    """User BAM already on VS-1: check @SQ, then enter markdup."""
    input:
        bam=sample_bam,
        fai=REF_FAI,
    output:
        bam=temp(os.path.join(RESULTS, "bam", "{sample}.lifted.bam")),
    wildcard_constraints:
        sample=BAM_WC,
    shell:
        """
        mkdir -p $(dirname {output.bam})
        python -m grapeancestry.core.ingest_bam \
          --in-bam {input.bam} --out-bam {output.bam} --ref-fai {input.fai}
        """


rule map_pe:
    input:
        r1=os.path.join(RESULTS, "trim", "{sample}_1.fq.gz"),
        r2=os.path.join(RESULTS, "trim", "{sample}_2.fq.gz"),
        ref=ALIGN_REF,
    output:
        bam=temp(os.path.join(RESULTS, "bam", "{sample}.raw.bam")),
    threads: THREADS
    params:
        rg=lambda w: f"@RG\\tID:{w.sample}\\tSM:{w.sample}\\tPL:ILLUMINA",
        seed=BWA_MEM_SEED,
        minsc=BWA_MEM_T,
        min_mq=MIN_MQ,
    wildcard_constraints:
        sample=PE_WC,
    shell:
        """
        mkdir -p $(dirname {output.bam})
        bwa mem -t {threads} -k {params.seed} -T {params.minsc} -R '{params.rg}' \
          {input.ref} {input.r1} {input.r2} \
          | samtools view -b -q {params.min_mq} -o {output.bam}
        """


rule map_se:
    input:
        r1=os.path.join(RESULTS, "trim", "{sample}.fq.gz"),
        ref=ALIGN_REF,
    output:
        bam=temp(os.path.join(RESULTS, "bam", "{sample}.raw.bam")),
    threads: THREADS
    params:
        rg=lambda w: f"@RG\\tID:{w.sample}\\tSM:{w.sample}\\tPL:ILLUMINA",
        seed=BWA_MEM_SEED,
        minsc=BWA_MEM_T,
        min_mq=MIN_MQ,
    wildcard_constraints:
        sample=SE_WC,
    shell:
        """
        mkdir -p $(dirname {output.bam})
        bwa mem -t {threads} -k {params.seed} -T {params.minsc} -R '{params.rg}' \
          {input.ref} {input.r1} \
          | samtools view -b -q {params.min_mq} -o {output.bam}
        """


rule map_aln:
    """aDNA SE: bwa aln + samse (short damaged reads)."""
    input:
        r1=os.path.join(RESULTS, "trim", "{sample}.fq.gz"),
        ref=ALIGN_REF,
    output:
        bam=temp(os.path.join(RESULTS, "bam", "{sample}.raw.bam")),
    threads: THREADS
    params:
        rg=lambda w: f"@RG\\tID:{w.sample}\\tSM:{w.sample}\\tPL:ILLUMINA",
        seed=BWA_ALN_L,
        maxn=BWA_ALN_N,
        maxgap=BWA_ALN_O,
        min_mq=MIN_MQ,
    wildcard_constraints:
        sample=ADNA_WC,
    shell:
        """
        mkdir -p $(dirname {output.bam})
        bwa aln -t {threads} -l {params.seed} -n {params.maxn} -o {params.maxgap} \
          {input.ref} {input.r1} > {output.bam}.sai
        bwa samse -r '{params.rg}' {input.ref} {output.bam}.sai {input.r1} \
          | samtools view -b -q {params.min_mq} -o {output.bam}
        rm -f {output.bam}.sai
        """


rule lift_or_copy:
    """v1 is full VS-1 mapping; pass the raw BAM through."""
    input:
        bam=os.path.join(RESULTS, "bam", "{sample}.raw.bam"),
        fai=REF_FAI,
    output:
        bam=temp(os.path.join(RESULTS, "bam", "{sample}.lifted.bam")),
    wildcard_constraints:
        sample=FQ_WC,
    shell:
        """
        cp {input.bam} {output.bam}
        """


rule sort_markdup:
    input:
        bam=os.path.join(RESULTS, "bam", "{sample}.lifted.bam"),
    output:
        bam=os.path.join(RESULTS, "bam", "{sample}.markdup.bam"),
        bai=os.path.join(RESULTS, "bam", "{sample}.markdup.bam.bai"),
    threads: THREADS
    params:
        pe=lambda w: is_pe(w.sample),
    wildcard_constraints:
        sample=ANY_WC,
    shell:
        """
        mkdir -p $(dirname {output.bam})
        if [ "{params.pe}" = "True" ]; then
          samtools sort -@ {threads} -n -o {output.bam}.namesort.bam {input.bam}
          samtools fixmate -m {output.bam}.namesort.bam {output.bam}.fixmate.bam
          samtools sort -@ {threads} -o {output.bam}.pos.bam {output.bam}.fixmate.bam
          samtools markdup -@ {threads} {output.bam}.pos.bam {output.bam}
          rm -f {output.bam}.namesort.bam {output.bam}.fixmate.bam {output.bam}.pos.bam
        else
          # SE: no fixmate; coordinate-sort then markdup
          samtools sort -@ {threads} -o {output.bam}.pos.bam {input.bam}
          samtools markdup -@ {threads} -r {output.bam}.pos.bam {output.bam} 2>/dev/null \
            || samtools markdup -@ {threads} {output.bam}.pos.bam {output.bam}
          rm -f {output.bam}.pos.bam
        fi
        samtools index {output.bam}
        """


rule call:
    input:
        bam=os.path.join(RESULTS, "bam", "{sample}.markdup.bam"),
        bai=os.path.join(RESULTS, "bam", "{sample}.markdup.bam.bai"),
        ref=REF_FA,
        sites=SITES_BED,
    output:
        vcf=os.path.join(RESULTS, "{sample}.vcf.gz"),
        tbi=os.path.join(RESULTS, "{sample}.vcf.gz.tbi"),
    threads: THREADS
    params:
        min_mq=MIN_MQ,
        min_bq=MIN_BQ,
        max_depth=MAX_DEPTH,
        adjust_mq=ADJUST_MQ,
        dp_filter=_dp_filter(),
    shell:
        """
        bcftools mpileup -f {input.ref} -T {input.sites} -a FORMAT/DP,FORMAT/AD \
          -q {params.min_mq} -Q {params.min_bq} -d {params.max_depth} -C {params.adjust_mq} \
          --threads {threads} -Ou {input.bam} \
        | bcftools call -m -Ou \
        | bcftools filter {params.dp_filter} -Oz -o {output.vcf}
        bcftools index -t {output.vcf}
        """
